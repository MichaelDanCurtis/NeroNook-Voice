  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+(?![\\s\\S])"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}(?![\\s\\S])"
    },
    "features": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,79}(?![\\s\\S])"
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "connectorBundleIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "serviceIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "resourceRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "protocolVersion",
        "connectorBundleIdentifier",
        "serviceIdentifier",
        "resourceRevision"
      ]
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "enum": [
            "moduleAdapter",
            "capabilityClient"
          ]
        },
        "nonce": {
          "$ref": "#/$defs/uuid"
        },
        "features": {
          "$ref": "#/$defs/features"
        },
        "requiredFeatures": {
          "$ref": "#/$defs/features"
        },
        "requestedCapabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "moduleIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "resourceRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "serviceIdentifier",
        "role",
        "nonce",
        "features",
        "requiredFeatures",
        "requestedCapabilities"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "moduleAdapter"
              }
            }
          },
          "then": {
            "required": [
              "moduleIdentifier",
              "resourceRevision"
            ],
            "properties": {
              "requestedCapabilities": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "moduleIdentifier"
                  ]
                },
                {
                  "required": [
                    "resourceRevision"
                  ]
                }
              ]
            },
            "properties": {
              "requestedCapabilities": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "moduleAdapter",
            "capabilityClient"
          ]
        },
        "clientNonce": {
          "$ref": "#/$defs/uuid"
        },
        "serviceNonce": {
          "$ref": "#/$defs/uuid"
        },
        "features": {
          "$ref": "#/$defs/features"
        },
        "moduleIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "resourceRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "role",
        "clientNonce",
        "serviceNonce",
        "features"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "moduleAdapter"
              }
            }
          },
          "then": {
            "required": [
              "moduleIdentifier",
              "resourceRevision"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "moduleIdentifier"
                  ]
                },
                {
                  "required": [
                    "resourceRevision"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "definition": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 10924,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "definition"
      ]
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "id"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "state": {
          "enum": [
            "pending",
            "granted",
            "denied",
            "revoked"
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      },
      "required": [
        "id",
        "state",
        "capabilities"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "granted"
              }
            }
          },
          "else": {
            "properties": {
              "capabilities": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 174764,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])"
        }
      },
      "required": [
        "plugin"
      ]
    },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/uuid"
        },
        "capability": {
          "$ref": "#/$defs/key"
        },
        "values": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 10924,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])"
        }
      },
      "required": [
        "run",
        "capability",
        "values"
      ]
    },
    "runFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/uuid"
        },
        "frame": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 21848,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])"
        }
      },
      "required": [
        "run",
        "frame"
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/uuid"
        },
        "update": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 43692,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])"
        }
      },
      "required": [
        "run",
        "update"
      ]
    },
    "runReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "run"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "ownerBusy",
            "approvalRequired",
            "draining",
            "unknownRun",
            "protocolViolation",
            "ownerStopping",
            "capabilityRefused"
          ]
        },
        "run": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "code"
      ]
    },
    "retired": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/uuid"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "refused"
          ]
        }
      },
      "required": [
        "run",
        "outcome"
      ]
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  }
}
